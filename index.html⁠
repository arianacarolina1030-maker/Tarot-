<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarot Archivo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background-color: #0d0f1d;
            color: #e2e8f0;
        }
        .card-bg {
            background-color: #131629;
            border: 1px solid #232742;
        }
        .card-hover:hover {
            border-color: #a855f7;
            box-shadow: 0 0 15px rgba(168, 85, 247, 0.2);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center p-4">

    <!-- Header / Navbar -->
    <header class="w-full max-w-md flex justify-between items-center py-4 mb-4">
        <div class="flex items-center gap-2">
            <i class="fas fa-moon text-purple-400 text-xl"></i>
            <h1 class="font-bold tracking-wider text-purple-200">TAROT ARCHIVO</h1>
        </div>
        <!-- Pestañas de navegación -->
        <div class="flex gap-1 bg-[#131629] p-1 rounded-xl border border-[#232742]">
            <button onclick="switchTab('archivo')" id="btn-archivo" class="px-3 py-1.5 text-xs font-medium rounded-lg text-gray-400 transition">Archivo</button>
            <button onclick="switchTab('oraculo')" id="btn-oraculo" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-purple-600 text-white shadow">Oráculo</button>
            <button onclick="switchTab('creador')" id="btn-creador" class="px-3 py-1.5 text-xs font-medium rounded-lg text-gray-400 transition">Creador</button>
        </div>
    </header>

    <!-- Contenedor Principal -->
    <main class="w-full max-w-md flex-1 flex flex-col items-center pb-8">
        
        <!-- Sección Oráculo -->
        <div id="tab-oraculo" class="w-full flex flex-col items-center">
            <div class="text-center mb-6">
                <h2 class="text-xl font-bold text-purple-200 mb-1">Tirada Diaria del Archivo</h2>
                <p class="text-xs text-gray-400">Mensaje tradicional combinado con la perspectiva cotidiana.</p>
            </div>

            <!-- Carta Interactiva -->
            <div class="card-bg w-full h-96 rounded-2xl flex flex-col items-center justify-center p-6 mb-6 card-hover transition duration-300 relative overflow-hidden text-center shadow-xl">
                <div id="card-content" class="flex flex-col items-center justify-center">
                    <div class="w-16 h-16 rounded-full bg-purple-900/40 flex items-center justify-center mb-4 border border-purple-500/30">
                        <i class="fas fa-crystal-ball text-purple-400 text-2xl animate-pulse"></i>
                    </div>
                    <span class="text-sm text-gray-400">Toca el botón para revelar tu energía</span>
                </div>
            </div>

            <!-- Botón de acción -->
            <button onclick="drawCard()" class="w-full py-3.5 bg-purple-600 hover:bg-purple-500 text-white font-medium rounded-xl shadow-lg shadow-purple-600/30 transition active:scale-95">
                Sacar Carta
            </button>
        </div>

        <!-- Sección Archivo (Oculta por defecto) -->
        <div id="tab-archivo" class="w-full hidden flex flex-col items-center text-center">
            <h2 class="text-xl font-bold text-purple-200 mb-2">Biblioteca del Archivo</h2>
            <p class="text-xs text-gray-400 mb-6">Explora los arcanos y sus significados ocultos.</p>
            <div class="card-bg w-full p-6 rounded-2xl text-gray-300 text-sm">
                Pronto encontrarás aquí el registro detallado de todas las tiradas y arcanos guardados.
            </div>
        </div>

        <!-- Sección Creador (Oculta por defecto) -->
        <div id="tab-creador" class="w-full hidden flex flex-col items-center text-center">
            <h2 class="text-xl font-bold text-purple-200 mb-2">Espacio del Creador</h2>
            <p class="text-xs text-gray-400 mb-6">Personaliza tu experiencia mística.</p>
            <div class="card-bg w-full p-6 rounded-2xl text-gray-300 text-sm">
                Herramientas de configuración y notas personales del oráculo.
            </div>
        </div>

    </main>

    <script>
        const cardsData = [
            { title: "El As de Bastos", desc: "Un impulso de energía creativa irrumpe en tu rutina laboral. Es momento de tomar iniciativas." },
            { title: "La Rueda de la Fortuna", desc: "Los ciclos cambian. Una situación inesperada en tu entorno profesional se alinea a tu favor." },
            { title: "La Suma Sacerdotisa", desc: "Confía en tu intuición frente a esa decisión importante. No todo lo que brilla en el trabajo es lo que parece." },
            { title: "El Ermitaño", desc: "Un momento de pausa y reflexión interna te dará la perspectiva exacta que necesitas para avanzar." }
        ];

        function switchTab(tabName) {
            document.getElementById('tab-oraculo').classList.add('hidden');
            document.getElementById('tab-archivo').classList.add('hidden');
            document.getElementById('tab-creador').classList.add('hidden');
            
            document.getElementById('btn-oraculo').className = "px-3 py-1.5 text-xs font-medium rounded-lg text-gray-400 transition";
            document.getElementById('btn-archivo').className = "px-3 py-1.5 text-xs font-medium rounded-lg text-gray-400 transition";
            document.getElementById('btn-creador').className = "px-3 py-1.5 text-xs font-medium rounded-lg text-gray-400 transition";

            document.getElementById('tab-' + tabName).classList.remove('hidden');
            document.getElementById('btn-' + tabName).className = "px-3 py-1.5 text-xs font-medium rounded-lg bg-purple-600 text-white shadow";
        }

        function drawCard() {
            const randomCard = cardsData[Math.floor(Math.random() * cardsData.length)];
            const container = document.getElementById('card-content');
            container.innerHTML = `
                <div class="text-purple-300 font-bold text-lg mb-2">${randomCard.title}</div>
                <p class="text-sm text-gray-300 leading-relaxed px-2">${randomCard.desc}</p>
            `;
        }
    </script>
</body>
</html>


